<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Jailbreak-specific entitlements -->
    <key>com.apple.private.security.no-sandbox</key>
    <true/>
    
    <!-- Allow loading arbitrary libraries (for Wine DLLs) -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    
    <!-- Allow JIT memory allocation -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    
    <!-- Disable code signing enforcement -->
    <key>com.apple.security.cs.disable-code-signature-enforcement</key>
    <true/>
    
    <!-- Allow dyld loading -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    
    <!-- File access -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
    <key>com.apple.security.files.downloads.read-write</key>
    <true/>
    
    <!-- Network access -->
    <key>com.apple.security.network.client</key>
    <true/>
    <key>com.apple.security.network.server</key>
    <true/>
    
    <!-- Allow arbitrary sockets (for Wine named pipes) -->
    <key>com.apple.security.network.sockets</key>
    <dict>
        <key>allow-unsigned</key>
        <true/>
        <key>allow-local-networking</key>
        <true/>
    </dict>
    
    <!-- Memory allocation -->
    <key>com.apple.security.memory</key>
    <dict>
        <key>allow-allocated-memory</key>
        <true/>
    </dict>
    
    <!-- Debugging -->
    <key>com.apple.security.get-task-allow</key>
    <true/>
</dict>
</plist>
